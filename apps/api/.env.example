DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=architecture
DATABASE_USER=architecture
DATABASE_PASSWORD=architecture

REDIS_HOST=localhost
REDIS_PORT=6379
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Enable only when the API is behind a trusted reverse proxy.
TRUST_PROXY=false

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=user
SMTP_PASSWORD=user
SMTP_FROM_ADDRESS=no-reply@architecture.local
# Complete URL of the web page that receives the token and calls the API.
SMTP_VERIFY_URL=http://localhost:5173/verify
SMTP_RECOVERY_URL=http://localhost:5173/recovery
SMTP_DELETION_CANCELLATION_URL=http://localhost:5173/cancel-deletion
SECURITY_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Password policy: standard, elevated (default), critical, or custom.
PASSWORD_POLICY_LEVEL=elevated
PASSWORD_PRIVILEGED_POLICY_LEVEL=critical
PASSWORD_MAX_LENGTH=128
# PASSWORD_MIN_LENGTH=15
# PASSWORD_MINIMUM_STRENGTH=acceptable
PASSWORD_CHECK_COMMON=true
PASSWORD_CHECK_COMPROMISED=true
PASSWORD_CHECK_CONTEXT=true
PASSWORD_REJECT_CURRENT=true
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_REQUIRE_LOWERCASE=false
PASSWORD_REQUIRE_NUMBER=false
PASSWORD_REQUIRE_SPECIAL=false
