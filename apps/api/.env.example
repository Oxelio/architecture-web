DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=architecture
DATABASE_USER=architecture
DATABASE_PASSWORD=architecture

REDIS_HOST=localhost
REDIS_PORT=6379
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Enable only when the API is behind a trusted reverse proxy.
TRUST_PROXY=false

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=user
SMTP_PASSWORD=user
SMTP_FROM_ADDRESS=no-reply@architecture.local
# Complete URL of the web page that receives the token and calls the API.
SMTP_VERIFY_URL=http://localhost:5173/verify
SMTP_RECOVERY_URL=http://localhost:5173/recovery
SMTP_DELETION_CANCELLATION_URL=http://localhost:5173/cancel-deletion
SECURITY_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Optional OAuth issuer configuration, supplied as JSON using deployment-managed secrets.
# Use the HTTPS origin serving both the issuer endpoints and first-party sign-in.
# Supply issuer, cookieKeys, artifactKeys, bindingKeys and jwks.
# Each symmetric key ring uses distinct base64url-encoded 32-byte keys, with the active key first.
# jwks contains private P-256 ES256 signing keys with stable key IDs.
# See TD-DELEGATED-AUTHORIZATION-001 for key rotation and ingress requirements.
# DELEGATED_OAUTH_CONFIG=

# Optional multichannel notification providers.
# NOTIFICATIONS_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# NOTIFICATIONS_SMS_WEBHOOK_URL=https://sms-provider.example/messages
