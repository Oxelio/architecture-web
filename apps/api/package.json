{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.3",
      "onFail": "download"
    }
  },
  "imports": {
    "#composition-root/*": "./composition-root/*.js",
    "#controllers/*": "./controllers/*.js",
    "#routes/*": "./routes/*.js",
    "#presentation/*": "./presentation/*.js"
  },
  "type": "module",
  "dependencies": {
    "@architecture/identity": "workspace:*",
    "@architecture/identity-persistence-kysely": "workspace:*",
    "@architecture/identity-password-argon2": "workspace:*",
    "@architecture/identity-session-redis": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.11.1",
    "kysely": "^0.29.2",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
