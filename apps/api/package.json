{
  "name": "api",
  "private": true,
  "version": "1.0.0-alpha.1",
  "description": "",
  "main": "main.mjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsdown",
    "start": "node dist/main.mjs",
    "migrate:up": "tsx src/scripts/migrate-up.ts",
    "migrate:down": "tsx src/scripts/migrate-down.ts",
    "migrate:reset": "tsx src/scripts/migrate-reset.ts",
    "promote:admin": "tsx src/scripts/promote-admin.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [],
  "author": "",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.3",
      "onFail": "download"
    }
  },
  "imports": {
    "#adapters/*": "./src/adapters/*.ts",
    "#app/*": "./src/*.ts",
    "#config/*": "./src/config/*.ts",
    "#helpers/*": "./src/helpers/*.ts",
    "#features/*": "./src/features/*.ts",
    "#composition-root/*": "./src/composition-root/*.ts",
    "#types/*": "./src/types/*.ts",
    "#iam/*": "./src/features/iam/*.ts",
    "#package": "./package.json"
  },
  "type": "module",
  "dependencies": {
    "@architecture/audit": "workspace:*",
    "@architecture/iam": "workspace:*",
    "@architecture/iam-email-nodemailer": "workspace:*",
    "@architecture/iam-email-verification-sha256": "workspace:*",
    "@architecture/iam-password-argon2": "workspace:*",
    "@architecture/iam-persistence-kysely": "workspace:*",
    "@architecture/iam-session-redis": "workspace:*",
    "@architecture/messaging": "workspace:*",
    "@architecture/messaging-persistence-kysely": "workspace:*",
    "@architecture/notifications": "workspace:*",
    "@architecture/notifications-delivery-nodemailer": "workspace:*",
    "@architecture/notifications-delivery-slack-webhook": "workspace:*",
    "@architecture/notifications-delivery-sms-webhook": "workspace:*",
    "@architecture/notifications-persistence-kysely": "workspace:*",
    "@architecture/notifications-recipient-iam-kysely": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.11.1",
    "kysely": "^0.29.4",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@architecture/eslint-config": "workspace:*",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
