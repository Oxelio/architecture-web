{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "migrate:up": "tsx src/scripts/migrate-up.ts",
    "migrate:down": "tsx src/scripts/migrate-down.ts",
    "migrate:reset": "tsx src/scripts/migrate-reset.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.3",
      "onFail": "download"
    }
  },
  "imports": {
    "#controllers/*": "./dist/controllers/*.js",
    "#routes/*": "./dist/routes/*.js",
    "#presentation/*": "./dist/presentation/*.js",
    "#composition-root/*": "./dist/composition-root/*.js",
    "#schema/*": "./dist/schema/*.js"
  },
  "type": "module",
  "dependencies": {
    "@architecture/identity": "workspace:*",
    "@architecture/identity-email-nodemailer": "workspace:*",
    "@architecture/identity-password-argon2": "workspace:*",
    "@architecture/identity-persistence-kysely": "workspace:*",
    "@architecture/identity-session-redis": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.8.0",
    "@fastify/swagger-ui": "^6.1.0",
    "@sinclair/typebox": "^0.34.49",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.11.1",
    "kysely": "^0.29.2",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
