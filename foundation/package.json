{
  "name": "@architecture/foundation",
  "version": "1.0.0-alpha.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.3",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "fast-deep-equal": "^3.1.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
