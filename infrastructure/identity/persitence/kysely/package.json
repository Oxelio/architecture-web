{
  "name": "@architecture/identity-persistence-kysely",
  "version": "1.0.0-alpha.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#persistence/*": "./src/persistence/*.ts",
    "#mappers/*": "./src/mappers/*.ts",
    "#errors/*": "./src/errors/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@architecture/identity": "^1.0.0-alpha.1",
    "kysely": "^0.29.2"
  },
  "devDependencies": {
    "@architecture/eslint-config": "1.0.0-alpha.1",
    "eslint": "^9.39.5",
    "@types/node": "^25.9.0",
    "typescript": "^5.9.3"
  }
}
