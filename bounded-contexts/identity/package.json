{
  "name": "@architecture/identity",
  "version": "1.0.0-alpha.1",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build"
  },
  "imports": {
    "#entities/*": "./dist/domain/entities/*.js",
    "#value-objects/*": "./dist/domain/value-objects/*.js",
    "#contracts/*": "./dist/application/contracts/*.js",
    "#dtos/*": "./dist/application/dtos/*.js",
    "#adapters/*": "./dist/infrastructure/adapters/*.js",
    "#application/*": "./dist/application/*.js",
    "#errors/*": "./dist/domain/errors/*.js",
    "#policies/*": "./dist/domain/policies/*.js",
    "#ports/*": "./dist/application/ports/*.js",
    "#use-cases/*": "./dist/application/use-cases/*.js"
  },
  "exports": {
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./application": {
      "types": "./dist/application/index.d.ts",
      "default": "./dist/application/index.js"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure/index.d.ts",
      "default": "./dist/infrastructure/index.js"
    }
  },
  "dependencies": {
    "@architecture/foundation": "^1.0.0-alpha.1",
    "ioredis": "^5.11.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
