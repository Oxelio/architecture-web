{
  "name": "@architecture/identity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "imports": {
    "#entities/*": "./domain/entities/*.js",
    "#value-objects/*": "./domain/value-objects/*.js",
    "#contracts/*": "./application/contracts/*.js",
    "#dtos/*": "./application/dtos/*.js",
    "#adapters/*": "./infrastructure/adaptaters/*.js",
    "#persistence/*": "./infrastructure/persistence/*.js",
    "#mappers/*": "./infrastructure/mappers/*.js"
  },
  "exports": {
    "./application": {
      "types": "./application/index.ts",
      "default": "./application/index.js"
    },
    "./infrastructure": {
      "types": "./infrastructure/index.ts",
      "default": "./infrastructure/index.js"
    },
    "./infrastructure/persistence/schema": {
      "types": "./infrastructure/persistence/schema.ts",
      "default": "./infrastructure/persistence/schema.js"
    },
    "./infrastructure/persistence/migrations/postgres": {
      "types": "./infrastructure/persistence/migrations/001_create_identity_users.ts",
      "default": "./infrastructure/persistence/migrations/001_create_identity_users.js"
    }
  },
  "dependencies": {
    "@architecture/foundation": "workspace:*",
    "argon2": "^0.44.0",
    "kysely": "^0.29.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.9.3"
  }
}
