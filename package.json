{
  "name": "architecture-web",
  "private": true,
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "migrate:up": "pnpm --filter api migrate:up",
    "migrate:down": "pnpm --filter api migrate:down",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "typecheck:test": "pnpm -r --if-present run typecheck:test",
    "lint": "pnpm -r --if-present run lint",
    "lint:fix": "pnpm -r --if-present run lint:fix",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "docs:links": "node scripts/check-markdown-links.mjs",
    "docs:links:test": "node --test scripts/check-markdown-links.test.mjs",
    "release:plan": "pnpm --filter @architecture/delivery-automation release:plan",
    "ci:test": "node scripts/run-workspace-tests.mjs",
    "ci:test:integration": "node scripts/run-integration-tests.mjs",
    "ci:test:tooling": "node -e \"const fs=require('node:fs');fs.mkdirSync('coverage/scripts', { recursive: true });fs.rmSync('coverage/scripts/lcov.info', { force: true })\" && node --test --experimental-test-coverage --test-coverage-include=scripts/*.mjs --test-coverage-exclude=scripts/*.test.mjs --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/scripts/lcov.info scripts/run-workspace-tests.test.mjs scripts/merge-coverage.test.mjs"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,jsonc,md,yaml,yml,css,html}": "prettier --write"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@architecture/eslint-config": "workspace:*",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^24.15.0 || ^26.8.1"
  }
}
