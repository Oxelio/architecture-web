{
  "name": "architecture-web",
  "private": true,
  "version": "1.0.0-alpha.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "lint:fix": "pnpm -r --if-present run lint:fix",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "format": "pnpm -r --if-present run format",
    "format:check": "pnpm -r --if-present run format:check"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,jsonc,md,yaml,yml,css,html}": "prettier --write"
  },
  "keywords": [],
  "author": "",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "devDependencies": {
    "@architecture/eslint-config": "workspace:*",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  }
}
