{
  "name": "@architecture/audit",
  "version": "1.0.0-alpha.1",
  "type": "module",
  "imports": {
    "#domain/*": {
      "types": "./domain/*.ts",
      "default": "./dist/domain/*.js"
    },
    "#events/*": {
      "types": "./application/events/*.ts",
      "default": "./dist/application/events/*.js"
    },
    "#repositories/*": {
      "types": "./application/repositories/*.ts",
      "default": "./dist/application/repositories/*.js"
    },
    "#services/*": {
      "types": "./application/services/*.ts",
      "default": "./dist/application/services/*.js"
    }
  },
  "exports": {
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./application": {
      "types": "./dist/application/index.d.ts",
      "default": "./dist/application/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@architecture/messaging": "workspace:*"
  },
  "devDependencies": {
    "@architecture/eslint-config": "workspace:*",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
