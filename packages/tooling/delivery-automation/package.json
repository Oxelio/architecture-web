{
  "name": "@architecture/delivery-automation",
  "private": true,
  "version": "1.0.0-alpha.1",
  "type": "module",
  "scripts": {
    "inventory": "tsx src/cli/inventory.ts",
    "activation:verify": "tsx src/cli/activation-verify.ts",
    "claim": "tsx src/cli/task-claim.ts",
    "claim:reconcile-plan": "tsx src/cli/claim-reconcile-plan.ts",
    "coordinator:dry-run": "tsx src/cli/coordinator-dry-run.ts",
    "coordinator:dispatch": "tsx src/cli/coordinator-dispatch.ts",
    "target:verify": "tsx src/cli/target-verify.ts",
    "gate:work-merge:evaluate": "tsx src/cli/work-merge-gate-evaluate.ts",
    "gate:check:publish": "tsx src/cli/gate-check-publish.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "release:plan": "tsx src/cli/release.ts plan",
    "release:ci-plan": "tsx src/cli/release.ts ci-plan",
    "release:generate": "tsx src/cli/release.ts generate",
    "release:publish": "tsx src/cli/release.ts publish"
  },
  "devDependencies": {
    "@architecture/eslint-config": "workspace:*",
    "@release-it/bumper": "8.0.1",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "^25.9.5",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.10",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "conventional-commits-parser": "7.1.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "release-it": "21.1.1",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.1"
  }
}
