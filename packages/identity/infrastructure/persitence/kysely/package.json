{
  "name": "@architecture/identity-persistence-kysely",
  "version": "1.0.0-alpha.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#persistence/*": {
      "types": "./src/persistence/*.ts",
      "default": "./dist/persistence/*.js"
    },
    "#mappers/*": {
      "types": "./src/mappers/*.ts",
      "default": "./dist/mappers/*.js"
    },
    "#errors/*": {
      "types": "./src/errors/*.ts",
      "default": "./dist/errors/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@architecture/identity": "workspace:*",
    "kysely": "^0.29.2"
  },
  "devDependencies": {
    "@architecture/eslint-config": "workspace:*",
    "@types/node": "^25.9.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
