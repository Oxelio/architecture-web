{
  "name": "@architecture/delivery-automation",
  "private": true,
  "version": "1.0.0-alpha.1",
  "type": "module",
  "scripts": {
    "inventory": "tsx src/cli/inventory.ts",
    "activation:verify": "tsx src/cli/activation-verify.ts",
    "claim": "tsx src/cli/task-claim.ts",
    "claim:reconcile-plan": "tsx src/cli/claim-reconcile-plan.ts",
    "coordinator:dry-run": "tsx src/cli/coordinator-dry-run.ts",
    "coordinator:dispatch": "tsx src/cli/coordinator-dispatch.ts",
    "target:verify": "tsx src/cli/target-verify.ts",
    "gate:work-merge:evaluate": "tsx src/cli/work-merge-gate-evaluate.ts",
    "gate:release-promotion:evaluate": "tsx src/cli/release-promotion-gate-evaluate.ts",
    "gate:check:publish": "tsx src/cli/gate-check-publish.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@architecture/eslint-config": "workspace:*",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
