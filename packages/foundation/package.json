{
  "name": "@architecture/foundation",
  "version": "1.0.0-alpha.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#domain/*": {
      "types": "./src/domain/*.ts",
      "default": "./dist/domain/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.3",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "fast-deep-equal": "^3.1.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@architecture/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
